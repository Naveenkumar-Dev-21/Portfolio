# Reinstalled inside the image by `npm ci`; copying the host tree in would
# be slow and can smuggle in wrong-platform native binaries.
node_modules

# Build artifacts — regenerated by `next build` inside the image.
.next
out
dist
build

# Version control and CI
.git
.gitignore
.github
.gitlab-ci.yml

# Secrets — must never enter the build context. Anything COPY'd stays
# recoverable from published image layers even if deleted later.
.env
.env.*
*.pem
*.key

# Editor / OS noise
.vscode
.idea
.DS_Store
*.swp

# Superseded by the ~114 kB profile-portrait.webp the site actually loads;
# excluding the 1.5 MB original keeps it out of every image pull.
public/profile.jpg

# Docs and local tooling that don't belong in a runtime image
*.md
docker-compose.yml
profile-snake-workflow.yml
.vercel
coverage
*.log
npm-debug.log*
